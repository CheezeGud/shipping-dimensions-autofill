{
  "manifest_version": 3,
  "name": "Shipping Dimensions Autofill",
  "description": "Autofills saved product weights and dimensions into shipping label forms.",
  "version": "0.1.0",
  "homepage_url": "https://github.com/CheezeGud/shipping-dimensions-autofill",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Shipping Dimensions Autofill",
    "default_popup": "hello.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://fulfillment.eiz.com.au/*"],
      "js": ["content.js"]
    }
  ]
}